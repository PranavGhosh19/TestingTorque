rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // TORQUE CARE — DAILY WASH TRACKING FIRESTORE SECURITY RULES
    //
    // Pure Mon–Sat daily car wash tracking & verification (Sundays rest).
    // Washers and Car Owners self-onboard; Admin oversees operations.
    // ===============================================================

    // ---------------------------------------------------------------
    // AUTHENTICATION & ROLE HELPERS
    // ---------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          ('role' in request.auth.token && request.auth.token.role == 'admin')
          || exists(/databases/$(database)/documents/area_managers/$(request.auth.uid))
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ===============================================================
    // 1. CAR OWNERS & VEHICLES & DAILY WASH TRACKING
    // ===============================================================

    match /Car_Owners/{ownerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      // Daily calendar status & owner verification feedback (Yes/No)
      match /DailyFeedback/{dateId} {
        allow read, write: if true;
      }

      // Vehicles registered by the car owner
      match /Vehicles/{vehicleId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();

        // Daily wash records & before/after photo evidence
        match /Washes/{washId} {
          allow read, write: if true;
        }

        // Daily calendar status & owner verification feedback (Yes/No)
        match /Months/{monthDoc} {
          allow read, write: if true;

          match /Dates/{dateDoc} {
            allow read, write: if true;
          }
        }

        // Month-by-month historical subcollections
        match /{monthCol}/{dateDoc} {
          allow read, write: if true;
        }
      }
    }


    // ===============================================================
    // 2. WASHERS (Self-Onboarded Partner Network)
    // ===============================================================

    match /Washers/{washerId} {
      // Allow read so prospective washers can query their registration
      allow read: if true;
      // Washers onboard themselves, set passwords, and update route state
      allow create, update: if true;
      allow delete: if isAdmin();
    }


    // ===============================================================
    // 3. WASHER DIRECTORY (Common District & Society Discovery)
    // ===============================================================

    match /washer_directory/{washerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }


    // ===============================================================
    // 4. SOCIETIES (Housing Clusters & Coverage Areas)
    // ===============================================================

    match /Societies/{societyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /Car_Owners/{ownerId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin();

        match /Vehicles/{vehicleId} {
          allow read: if true;
          allow create, update: if true;
          allow delete: if isAdmin();
        }
      }
    }


    // ===============================================================
    // 5. ADMIN & OPERATIONAL NOTIFICATIONS
    // ===============================================================

    match /Admin_Notifications/{notifId} {
      allow read, write: if true;
    }


    // ===============================================================
    // 6. AREA MANAGERS / ADMIN PROFILES
    // ===============================================================

    match /area_managers/{managerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }


    // ===============================================================
    // 7. LEGACY USERS
    // ===============================================================

    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
