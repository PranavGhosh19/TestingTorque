rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (('role' in request.auth.token && request.auth.token.role == 'admin') || 
         ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.matches('.*@torquecare\\.com')));
    }

    // ===============================================================
    // 0. PRIMARY USERS COLLECTION (Firebase Auth UID Primary Identity)
    // users/{userId}
    // ===============================================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // ===============================================================
    // 1. CAR OWNERS HIERARCHY
    // Car_Owners/{ownerId}
    //   └── Vehicles/{vehicleId}
    //         └── Washes/{washId}
    // ===============================================================
    match /Car_Owners/{ownerId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /Vehicles/{vehicleId} {
        allow read, create, update: if true;
        allow delete: if isAdmin();

        // Month -> Date Hierarchy
        // Car_Owners/{ownerId}/Vehicles/{vehicleId}/{monthCol}/{dateDoc}
        match /{monthCol}/{dateDoc} {
          allow read, create, update: if true;
          allow delete: if isAdmin();
        }

        // Nested Months collection
        match /Months/{monthDoc} {
          allow read, create, update: if true;
          allow delete: if isAdmin();

          match /Dates/{dateDoc} {
            allow read, create, update: if true;
            allow delete: if isAdmin();
          }
        }

        match /Washes/{washId} {
          allow read, create, update: if true;
          allow delete: if isAdmin();
        }
      }
    }

    // ===============================================================
    // 2. WASHERS COLLECTION
    // Washers/{washerId}
    // ===============================================================
    match /Washers/{washerId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Fallback for app collections during development & live operations
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
