rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // TORQUE CARE — FIRESTORE SECURITY RULES
    //
    // ROLE HIERARCHY
    //
    // super_admin
    //     ↓
    // admin / Area Manager
    //     ↓
    // washer
    //     ↓
    // customer
    //
    // Firebase Auth UID = canonical identity
    // Firebase Custom Auth Claims = canonical authorization
    //
    // NEVER use:
    // - email domain as a role
    // - phone number as UID
    // - public wildcard access
    // ===============================================================


    // ===============================================================
    // 1. AUTHENTICATION
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    // ===============================================================
    // 2. ROLE HELPERS
    // ===============================================================

    function isSuperAdmin() {
      return isAuthenticated()
        && 'role' in request.auth.token
        && request.auth.token.role == 'super_admin';
    }


    function isAreaManager() {
      return isAuthenticated()
        && (
          ('role' in request.auth.token && request.auth.token.role == 'admin')
          || exists(/databases/$(database)/documents/area_managers/$(request.auth.uid))
        );
    }


    function isAdmin() {
      return isAuthenticated()
        && (
          ('role' in request.auth.token && (
            request.auth.token.role == 'admin'
            || request.auth.token.role == 'super_admin'
          ))
          || exists(/databases/$(database)/documents/area_managers/$(request.auth.uid))
        );
    }


    // ===============================================================
    // 3. OWNER
    // ===============================================================

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }


    // ===============================================================
    // 4. WASHER OWNERSHIP
    // ===============================================================

    function ownsWasher(washerId) {
      return isAreaManager()
        && exists(
          /databases/$(database)/documents/Washers/$(washerId)
        )
        && get(
          /databases/$(database)/documents/Washers/$(washerId)
        ).data.createdBy == request.auth.uid;
    }


    // ===============================================================
    // 5. AREA MANAGERS
    // ===============================================================

    match /area_managers/{managerId} {

      // Own profile or Super Admin
      allow read: if isOwner(managerId)
        || isSuperAdmin();

      // Area Manager creating their own profile, or Super Admin
      allow create: if isOwner(managerId)
        || isSuperAdmin();

      // Own profile or Super Admin
      allow update: if isOwner(managerId)
        || isSuperAdmin();

      // Only Super Admin deletes
      allow delete: if isSuperAdmin();
    }


    // ===============================================================
    // 6. WASHERS — OPERATIONAL DATA & WASHER LOGIN
    // ===============================================================

    match /Washers/{washerId} {

      // -------------------------------------------------------------
      // READ
      // -------------------------------------------------------------
      // Allow read so prospective washers can query their registration
      // by email or phone on /washer/login before authentication.
      allow read: if true;


      // -------------------------------------------------------------
      // CREATE
      // -------------------------------------------------------------
      allow create: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();


      // -------------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------------
      // Washers can set their initial password or update last login,
      // and Area Managers / Admins can manage washer records.
      allow update: if true;


      // -------------------------------------------------------------
      // DELETE
      // -------------------------------------------------------------
      allow delete: if isAdmin() || isSuperAdmin();
    }


    // ===============================================================
    // 7. WASHER DIRECTORY — SANITIZED CUSTOMER DISCOVERY
    //
    // washer_directory/{washerId}
    //
    // ONLY NON-SENSITIVE INFORMATION.
    //
    // Customers:
    //   READ ONLY
    //
    // Area Managers:
    //   Manage their own washer directory records
    //
    // Super Admin:
    //   Full access
    // ===============================================================

    match /washer_directory/{washerId} {

      // -------------------------------------------------------------
      // READ
      // -------------------------------------------------------------
      //
      // Prospective customers during signup and authenticated users can discover available washers.
      //
      // IMPORTANT:
      // The collection contains ONLY sanitized fields (no sensitive info).
      // -------------------------------------------------------------

      allow read: if true;


      // -------------------------------------------------------------
      // CREATE
      // -------------------------------------------------------------

      allow create: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();


      // -------------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------------

      allow update: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();


      // -------------------------------------------------------------
      // DELETE
      // -------------------------------------------------------------

      allow delete: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();
    }


    // ===============================================================
    // 7B. SOCIETIES — FIRESTORE SOCIETY CATALOG
    //
    // Societies/{societyId}
    //
    // Customer:
    //   READ ONLY
    //
    // Area Manager:
    //   Manage societies they created
    //
    // Super Admin:
    //   Full access
    //
    // IMPORTANT:
    // societyId is the canonical relationship key.
    // ===============================================================

    match /Societies/{societyId} {

      // -------------------------------------------------------------
      // READ
      // -------------------------------------------------------------
      //
      // Prospective customers need to read available societies during signup before authenticating.
      // -------------------------------------------------------------

      allow read: if true;


      // -------------------------------------------------------------
      // CREATE
      // -------------------------------------------------------------

      allow create: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();


      // -------------------------------------------------------------
      // UPDATE
      // -------------------------------------------------------------

      allow update: if isAreaManager()
        || isAdmin()
        || isSuperAdmin();


      // -------------------------------------------------------------
      // DELETE
      // -------------------------------------------------------------

      allow delete: if isAdmin()
        || isSuperAdmin();

      // Car_Owners subcollection under Society: Societies/{societyId}/Car_Owners/{ownerId}
      match /Car_Owners/{ownerId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin() || isSuperAdmin();

        match /Vehicles/{vehicleId} {
          allow read: if true;
          allow create, update: if true;
          allow delete: if isAdmin() || isSuperAdmin();
        }
      }
    }


    // ===============================================================
    // 7B. STATE HIERARCHY — STATE (COLLECTION) -> CITY -> SOCIETY
    // ===============================================================

    match /State/{stateId} {
      allow read: if true;
      allow create, update: if isAreaManager() || isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();

      match /City/{cityId} {
        allow read: if true;
        allow create, update: if isAreaManager() || isSuperAdmin() || isAdmin();
        allow delete: if isSuperAdmin();

        match /Society/{societyId} {
          allow read: if true;
          allow create, update: if isAreaManager() || isSuperAdmin() || isAdmin();
          allow delete: if isSuperAdmin();

          match /Car_Owners/{ownerId} {
            allow read: if true;
            allow create, update: if true;
            allow delete: if isAdmin() || isSuperAdmin();

            match /Vehicles/{vehicleId} {
              allow read: if true;
              allow create, update: if true;
              allow delete: if isAdmin() || isSuperAdmin();
            }
          }
        }
      }
    }

    match /{path=**}/Society/{societyId} {
      allow read: if true;
      allow create, update: if isAreaManager() || isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin();

      match /Car_Owners/{ownerId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isAdmin() || isSuperAdmin();

        match /Vehicles/{vehicleId} {
          allow read: if true;
          allow create, update: if true;
          allow delete: if isAdmin() || isSuperAdmin();
        }
      }
    }


    // ===============================================================
    // 8. CAR OWNERS
    // ===============================================================

    match /Car_Owners/{ownerId} {

      allow read: if true;

      allow create, update: if true;

      allow delete: if isAdmin() || isSuperAdmin();


      // =============================================================
      // 8A. VEHICLES
      // =============================================================

      match /Vehicles/{vehicleId} {

        allow read: if true;

        allow create, update: if true;

        allow delete: if isAdmin() || isSuperAdmin();


        // ===========================================================
        // 8B. LEGACY MONTH / DATE STRUCTURE
        // ===========================================================

        match /{monthCol}/{dateDoc} {

          allow read, write: if true;
        }


        // ===========================================================
        // 8C. MONTHS / DATES
        // ===========================================================

        match /Months/{monthDoc} {

          allow read, write: if true;

          match /Dates/{dateDoc} {

            allow read, write: if true;
          }
        }


        // ===========================================================
        // 8D. WASH RECORDS
        // ===========================================================

        match /Washes/{washId} {

          allow read, write: if true;
        }
      }
    }


    // ===============================================================
    // 9. LEGACY USERS COLLECTION
    // ===============================================================

    match /users/{userId} {

      allow read, write: if false;
    }


    // ===============================================================
    // 10. DEFAULT DENY
    // ===============================================================
  }
}
